LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.xah.io/v1
LLM_MODEL=your-model
# Number of module-summary requests allowed in flight (1-8).
LLM_CONCURRENCY=4
# How many modules the model may explain per analysis. The rest keep their
# deterministic explanation. Ranked by coupling and hotspot score, so the
# modules the Big Picture and system-design views read are always covered.
LLM_SUMMARY_BUDGET=120
ANALYZER_MAX_FILES=10000
ANALYZER_MAX_BYTES=104857600
DATABASE_URL=postgresql://analyzer:analyzer@localhost:5432/analyzer
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2
